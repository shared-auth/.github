{
  "schema": "shared-auth/config-authority/v1",
  "consumer_policy": {
    "canonical_path": ".shared-auth.toml",
    "compatibility_aliases": [
      ".auth-shared.toml"
    ],
    "fail_if_multiple_present": true,
    "allowed_top_level_sections": [
      "schema_version",
      "compatibility",
      "factors",
      "pages",
      "styling"
    ],
    "required_top_level_sections": [
      "schema_version",
      "compatibility"
    ],
    "legacy_alias_state": "warning"
  },
  "fleet_topology": {
    "canonical_path": "config/shared-auth-topology.toml",
    "allowed_repositories": [
      "shared-auth-server.rs"
    ],
    "topology_only_sections": [
      "contract",
      "identity",
      "canonical_tables",
      "realms",
      "providers",
      "revocation",
      "root_admin",
      "applications"
    ]
  },
  "runtime": {
    "policy_path": ".shared-auth.toml",
    "legacy_policy_path": ".auth-shared.toml",
    "flags_path": ".cli-flags.toml",
    "strict_flags2env_revision": "b708a041531a830bd49f030250836896096e7abd",
    "consumer_repositories": [
      "shared-auth-cli",
      "shared-auth-web-server.rs",
      "shared-auth-api-server.rs",
      "shared-auth-admin-web-server.rs",
      "shared-auth-admin-api-server.rs"
    ],
    "realm_contract_path": "config/auth-realms.contract.json",
    "realm_contract_repositories": [
      "shared-auth-server.rs"
    ]
  },
  "runtime_adoption": {
    "schema": "shared-auth/runtime-adoption/v1",
    "owner": "shared-auth",
    "interfaces_repository": "https://github.com/shared-auth/shared-auth-interfaces",
    "interfaces_revision": "f62d9dbed2db6774dda04586328e6c485423fff6",
    "flags2env_repository": "https://github.com/flags-2-env/flags-2-env",
    "shared_auth_lib_core_repository": "https://github.com/shared-auth/shared-auth-lib-core.git",
    "shared_auth_lib_core_revision": "29cdb6e53e888c3f157f1371e6169fe8c3561be2",
    "flags2env_build_dependency_repositories": [
      "shared-auth-cli"
    ]
  },
  "invariants": [
    "consumer policy filenames never own fleet topology",
    "fleet topology never becomes a secret store or argv parser",
    "the presence of a policy file is not proof that a runtime loads it",
    "canonical and compatibility policy filenames may not coexist",
    "intended runtime consumers carry the canonical policy overlay and canonical flags contract",
    "Rust runtime consumers pin the reviewed strict flags2env revision before policy loading",
    "runtime consumers use the exact reviewed shared-auth-interfaces policy revision",
    "runtime consumers structurally pin the reviewed shared-auth-lib-core revision",
    "Cargo dependency evidence is parsed as TOML and cannot be satisfied by comments or unrelated strings",
    "topology authority is explicit and repository-scoped"
  ]
}
